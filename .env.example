# Credenciales locales para acceder a /gobierno.
# Define un usuario y una contraseña para la demo; no reutilices credenciales personales.
GOV_PANEL_USERNAME=
GOV_PANEL_PASSWORD=

# Docker Compose publica localhost:8000 por defecto. Usa 0.0.0.0 para la red local.
APP_PORT=8000
APP_BIND_ADDRESS=127.0.0.1

# Ruta opcional al modelo local de voz Piper.
PIPER_MODEL_PATH=

LUPITA_DEVICE_KEY=
