{$DOMAIN} {
    encode zstd gzip

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "no-referrer"
    }

    route {
        handle_path /downloads/* {
            root * /srv/downloads
            file_server
        }

        handle {
            reverse_proxy monitor:8100
        }
    }
}
